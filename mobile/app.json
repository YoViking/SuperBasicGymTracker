{
  "expo": {
    "name": "Workout Player",
    "slug": "workout-player",
    "scheme": "workoutplayer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yoviking.workoutplayer",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.yoviking.workoutplayer",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "pan"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-apple-authentication",
      "expo-secure-store",
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Workout Player behöver tillgång till dina foton för att välja en bild till dina träningsmappar.",
          "cameraPermission": "Workout Player behöver tillgång till kameran för att ta bilder till dina träningsmappar."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d83fc15b-f7ac-415a-b524-6482a06fb477"
      }
    }
  }
}